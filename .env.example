# Copy to .env locally or set in Netlify dashboard — NEVER commit real keys

# Paystack (https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx

# Sanity CMS (https://sanity.io/manage)
SANITY_PROJECT_ID=your_project_id
SANITY_DATASET=production
SANITY_API_TOKEN=sk...

# MongoDB Atlas — orders & invoices
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mark1615?retryWrites=true&w=majority
MONGODB_DB_NAME=mark1615

# Site
SITE_URL=http://localhost:8888
ORDER_EMAIL_FROM=shop@mark1615.co.za
ADMIN_EMAIL=team@mark1615.co.za

# Email (https://resend.com or SendGrid)
RESEND_API_KEY=re_xxxxxxxx

# Set to true to force demo checkout (no Paystack/MongoDB required)
SHOP_DEMO_MODE=true

# Shipping (ZAR)
SHIPPING_FLAT_RATE=80
FREE_SHIPPING_THRESHOLD=500
